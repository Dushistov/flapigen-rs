@@expect {"file":"test.rs","kind":"item","name":"BasicArc_value","form":"definition"}
#[allow(non_snake_case, unused_variables, unused_mut, unused_unsafe)]
#[unsafe(no_mangle)]
pub extern "C" fn BasicArc_value(this: *mut Mutex<BasicArc>) -> i32 {
    let this: &Mutex<BasicArc> = unsafe { this.as_mut().unwrap() };
    let mut this: MutexGuard<BasicArc> = this.lock().unwrap();
    let mut this: &BasicArc = &this;
    let mut ret: i32 = BasicArc::value(this);
