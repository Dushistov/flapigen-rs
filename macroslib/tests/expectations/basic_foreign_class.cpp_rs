@@expect {"file":"test.rs","kind":"item","name":"BasicBox_new","form":"definition"}
#[allow(unused_variables, unused_mut, non_snake_case, unused_unsafe)]
#[unsafe(no_mangle)]
pub extern "C" fn BasicBox_new(value: i32) -> *const ::std::os::raw::c_void {
    let this: BasicBox = BasicBox::new(value);
    let this: Box<BasicBox> = Box::new(this);
    let this: *mut BasicBox = Box::into_raw(this);
    this as *const ::std::os::raw::c_void
}
@@end

@@expect {"file":"test.rs","kind":"item","name":"BasicBox_delete","form":"definition"}
#[allow(unused_variables, unused_mut, non_snake_case, unused_unsafe)]
#[unsafe(no_mangle)]
pub extern "C" fn BasicBox_delete(this: *mut BasicBox) {
    let this: Box<BasicBox> = unsafe { Box::from_raw(this) };
    drop(this);
}
@@end

@@expect {"file":"test.rs","kind":"item","name":"BasicBox_value","form":"definition"}
