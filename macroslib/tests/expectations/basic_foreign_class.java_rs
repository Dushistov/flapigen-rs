@@expect {"file":"test.rs","kind":"item","name":"Java_org_example_BasicArc_do_1value","form":"definition"}
#[allow(non_snake_case, unused_variables, unused_mut, unused_unsafe)]
#[unsafe(no_mangle)]
pub extern "C" fn Java_org_example_BasicArc_do_1value(
    env: *mut JNIEnv,
    _: jclass,
    this: jlong,
) -> jint {
    let this: &Mutex<BasicArc> =
        unsafe { jlong_to_pointer::<Mutex<BasicArc>>(this).as_mut().unwrap() };
    let mut this: MutexGuard<BasicArc> = this.lock().unwrap();
    let mut this: &BasicArc = &this;
    let mut ret: i32 = BasicArc::value(this);
    let mut ret: jint = ret;
    ret
}
