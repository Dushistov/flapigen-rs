@@expect {"file":"test.rs","kind":"item","name":"Java_org_example_BasicBox_init","form":"definition"}
#[allow(unused_variables, unused_mut, non_snake_case, unused_unsafe)]
#[unsafe(no_mangle)]
pub extern "C" fn Java_org_example_BasicBox_init(
    env: *mut JNIEnv,
    _: jclass,
    value: jint,
) -> jlong {
    let mut value: i32 = value;
    let this: BasicBox = BasicBox::new(value);
    let this: Box<BasicBox> = Box::new(this);
    let this: *mut BasicBox = Box::into_raw(this);
    this as jlong
}
@@end

@@expect {"file":"test.rs","kind":"item","name":"Java_org_example_BasicBox_do_1delete","form":"definition"}
#[allow(unused_variables, unused_mut, non_snake_case, unused_unsafe)]
#[unsafe(no_mangle)]
pub extern "C" fn Java_org_example_BasicBox_do_1delete(env: *mut JNIEnv, _: jclass, this: jlong) {
    let this: *mut BasicBox = ::std::ptr::NonNull::new(jlong_to_pointer::<BasicBox>(this))
        .unwrap()
        .as_ptr();
    let this: Box<BasicBox> = unsafe { Box::from_raw(this) };
    drop(this);
}
@@end

