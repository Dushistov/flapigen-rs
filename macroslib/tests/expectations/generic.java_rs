@@expect {"after":"#[allow(non_snake_case, unused_variables, unused_mut, unused_unsafe)]\n#[unsafe(no_mangle)]\npub extern \"C\" fn Java_org_example_Boo_do_1now2(env: *mut JNIEnv, _: ","before":"jni_throw_exception(env, &msg);\n            return <jlong>::jni_invalid_value();\n        }\n    };\n    ret\n}\n#[allow(non_snake_case, unused_variables, unused_mut, unused_unsafe)]\n","file":"test.rs","kind":"between"}
#[unsafe(no_mangle)]
pub extern "C" fn Java_org_example_Boo_do_1now(env: *mut JNIEnv, _: jclass) -> jlong {
    let mut ret: SystemTime = now();
    let since_unix_epoch = ret
        .duration_since(::std::time::UNIX_EPOCH)
        .expect("SystemTime to Unix time conv. error");
    let mut ret: jlong = <i64 as ::std::convert::TryFrom<u64>>::try_from(
        since_unix_epoch.as_secs() * 1_000 + u64::from(since_unix_epoch.subsec_millis()),
    )
    .expect("SystemTime: milleseconds u64 to i64 convert error");
    ret
}

@@end
