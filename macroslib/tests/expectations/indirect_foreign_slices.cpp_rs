pub extern "C" fn IndirectSliceHost_arcs(
    this: *mut IndirectSliceHost,
) -> CRustSliceForeignIndirectArcNode {
    let this: &IndirectSliceHost = unsafe { this.as_mut().unwrap() };
    let mut ret: &[Arc<ArcNode>] = IndirectSliceHost::arcs(this);
    let mut ret: CRustSliceForeignIndirectArcNode = CRustSliceForeignIndirectArcNode {
