#[unsafe(no_mangle)]
pub extern "C" fn RustForeignVecArcNode_new() -> CRustForeignVecArcNode {
    let raw = CRustForeignVec::from_vec(Vec::<Arc<ArcNode>>::new());
    CRustForeignVecArcNode {
        data: raw.data.cast(),
        len: raw.len,
        capacity: raw.capacity,
    }
}
@@end

@@expect {"file":"test.rs","kind":"item","name":"RustForeignVecArcNode_clone_at","form":"definition"}
#[unsafe(no_mangle)]
pub extern "C" fn RustForeignVecArcNode_clone_at(
    v: CRustForeignVecArcNode,
    idx: usize,
) -> *mut ::std::os::raw::c_void {
    let slice: &[Arc<ArcNode>] = unsafe {
        (CRustSlice {
            data: v.data.cast(),
