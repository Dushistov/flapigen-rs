@@expect {"after":"#[allow(unused_variables, unused_mut, non_snake_case, unused_unsafe)]\n#[unsafe(no_mangle)]\npub extern \"C\" fn Java_org_example_Foo_init(env: *mut JNIEnv, _: jcla","before":"_env: *mut JNIEnv,\n    _: jclass,\n    _: jobject,\n    _: jobject,\n    _: jobject,\n    _: jobject,\n    _: jobject,\n    _: jobject,\n    _: jobject,\n    _: jobject,\n) {\n}\n","file":"test.rs","kind":"between"}
impl<'a> SwigForeignClass for Rc<RefCell<Foo<'a>>> {
    type PointedType = RefCell<Foo<'a>>;
    fn jni_class() -> jclass {
        swig_jni_find_class!(FOREIGN_CLASS_FOO, "org/example/Foo")
    }
    fn jni_class_pointer_field() -> jfieldID {
        swig_jni_get_field_id!(
            FOREIGN_CLASS_FOO_MNATIVEOBJ_FIELD,
            FOREIGN_CLASS_FOO,
            "mNativeObj",
            "J"
        )
    }
    fn box_object(this: Self) -> jlong {
        let this: *const RefCell<Foo> = Rc::into_raw(this);
        pointer_to_jlong(this)
    }
    fn unbox_object(x: jlong) -> Self {
        let x: *mut RefCell<Foo> = unsafe { jlong_to_pointer::<RefCell<Foo>>(x).as_mut().unwrap() };
        let x: Rc<RefCell<Foo>> = unsafe { Rc::from_raw(x) };
        x
    }
    fn to_pointer(x: jlong) -> ::std::ptr::NonNull<Self::PointedType> {
        let x: *mut RefCell<Foo> = unsafe { jlong_to_pointer::<RefCell<Foo>>(x).as_mut().unwrap() };
        ::std::ptr::NonNull::<Self::PointedType>::new(x).unwrap()
    }
}

@@end
