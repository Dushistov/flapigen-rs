@@expect {"file":"test.rs","kind":"item","name":"CRustSliceVecForeignRowFoo_get","form":"definition"}
#[unsafe(no_mangle)]
pub extern "C" fn CRustSliceVecForeignRowFoo_get(
    slice: CRustSliceVecForeignRowFoo,
    index: usize,
) -> CRustSliceVecForeignRowFooRowSlice {
    let rows = unsafe {
        (CRustSlice {
            data: slice.data.cast(),
            len: slice.len,
        })
        .as_slice::<Vec<RowFoo>>()
    };
    let row = &rows[index];
    CRustSliceVecForeignRowFooRowSlice {
        data: row.as_ptr().cast(),
        len: row.len(),
    }
}
@@end

