@@expect {"file":"test.rs","kind":"item","name":"TestReferences_update_foo","form":"definition"}
#[allow(non_snake_case, unused_variables, unused_mut, unused_unsafe)]
#[unsafe(no_mangle)]
pub extern "C" fn TestReferences_update_foo(
    this: *mut TestReferences,
    foo: *const ::std::os::raw::c_void,
) -> () {
    assert!(!foo.is_null());
    let foo: &Foo = unsafe { &*(foo as *const Foo) };
    let this: &mut TestReferences = unsafe { this.as_mut().unwrap() };
    let mut ret: () = TestReferences::update_foo(this, foo);
    ret
}
@@end

