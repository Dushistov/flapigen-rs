@@expect {"file":"test.rs","kind":"item","name":"StringSlices_refs","form":"definition"}
#[allow(non_snake_case, unused_variables, unused_mut, unused_unsafe)]
#[unsafe(no_mangle)]
pub extern "C" fn StringSlices_refs(this: *mut StringSlices) -> CRustSliceStrRef {
    let this: &StringSlices = unsafe { this.as_mut().unwrap() };
    let mut ret: &[&str] = StringSlices::refs(this);
    let mut ret: CRustSliceStrRef = CRustSliceStrRef {
        data: ret.as_ptr().cast(),
        len: ret.len(),
    };
    ret
}
@@end

